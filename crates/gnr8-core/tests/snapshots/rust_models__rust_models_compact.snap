}

/// Deserialize a key that may be absent or `null`: an absent key is `None`
/// (`#[serde(default)]`), a `null` is `Some(None)` and a value is `Some(Some(value))`.
fn deserialize_optional_nullable<'de, D, T>(
    deserializer: D,
) -> ::core::result::Result<Option<Option<T>>, D::Error>
where
    D: ::serde::Deserializer<'de>,
    T: ::serde::Deserialize<'de>,
{
    <Option<T> as ::serde::Deserialize<'de>>::deserialize(deserializer).map(Some)
}
