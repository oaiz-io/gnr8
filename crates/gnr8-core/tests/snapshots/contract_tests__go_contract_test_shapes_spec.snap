func TestTypedErrorUpdateAuthor400(t *testing.T) {
	transport := &contractTransport{responses: []*http.Response{contractResponse(400, map[string]string{"content-type": "application/json"}, "{\"message\":\"contract test error\",\"slug\":\"contract_test_error\"}")}}
	client := contractClient(transport)
	out, err := client.UpdateAuthor(context.Background(), "gnr8", &Author{Name: "gnr8"})
	_ = out
	assertContractStatus(t, err, 400)
	request := contractSingleRequest(t, transport)
	assertContractWire(t, request, "PUT", "/authors/gnr8", url.Values{}, map[string]string{"content-type": "application/json"})
	assertContractBody(t, request, "{\"name\":\"gnr8\"}")
}

