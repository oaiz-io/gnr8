func TestRedirectPolicyLogin(t *testing.T) {
	transport := &contractTransport{responses: []*http.Response{contractResponse(302, map[string]string{"location": "http://gnr8.test/moved"}, "")}}
	client := contractClient(transport)
	out, err := client.Login(context.Background(), LoginRequest{Email: "gnr8"})
	_ = out
	assertContractStatus(t, err, 302)
	// The 0.11 contract: a redirect is surfaced, never followed, unless the
	// caller opts in with WithFollowRedirects.
	request := contractSingleRequest(t, transport)
	assertContractWire(t, request, "POST", "/v1/auth/login", url.Values{}, map[string]string{"content-type": "application/json"})
	assertContractBody(t, request, "{\"email\":\"gnr8\"}")
}
