---
source: crates/gnr8-core/tests/snapshot_openapi.rs
expression: openapi
---
openapi: 3.1.0
info:
  title: goalservice
  version: 0.1.0
security:
  - ApiKeyAuth: []
paths:
  '/goal/':
    post:
      operationId: createGoal
      summary: Creates a goal for the calling actor.
      description: "The goal starts in the pending state and is assigned a server-generated\nidentifier, which is returned in the response."
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateGoalInput'
      responses:
        '201':
          description: Response 201
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CommandMessageWithUUID'
        '400':
          description: Response 400
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/HttpError'
  '/goal/list':
    get:
      operationId: listGoals
      summary: Returns a page of goals for the calling actor.
      description: "Results are ordered newest first and paginated with an opaque cursor. Pass the\ncursor from the previous page to continue; omit it to start from the beginning."
      parameters:
      - name: aggregation
        in: query
        required: false
        schema:
          type: string
      - name: cursor
        in: query
        required: false
        schema:
          type: string
      - name: page_size
        in: query
        required: false
        schema:
          type: string
      responses:
        '200':
          description: Response 200
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ListGoalsOutput'
  '/goal/{uuid}':
    put:
      operationId: updateGoal
      summary: Replaces the mutable fields of one goal.
      description: "The goal is identified by its uuid. Fields omitted from the payload are left\nunchanged; the goal's identifier and creation time are never modified."
      parameters:
      - name: uuid
        in: path
        required: true
        schema:
          type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UpdateGoalInput'
      responses:
        '200':
          description: Response 200
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CommandMessage'
        '400':
          description: Response 400
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/HttpError'
    delete:
      operationId: deleteGoal
      summary: Permanently removes one goal.
      parameters:
      - name: uuid
        in: path
        required: true
        schema:
          type: string
      responses:
        '200':
          description: Response 200
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CommandMessage'
        '400':
          description: Response 400
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/HttpError'
components:
  securitySchemes:
    ApiKeyAuth:
      type: apiKey
      in: header
      name: X-API-Key
  schemas:
    CommandMessage:
      type: object
      required: [message]
      properties:
        message:
          type: string
    CommandMessageWithUUID:
      type: object
      required: [message, uuid]
      properties:
        message:
          type: string
        uuid:
          type: string
          format: uuid
    CreateGoalInput:
      type: object
      required: [analyticsQuery, name]
      properties:
        analyticsQuery:
          oneOf:
          - $ref: '#/components/schemas/GoalAnalyticsQueryInput'
          - type: 'null'
        description:
          type: [string, 'null']
          description: Longer explanation
        name:
          type: string
          description: Short human-readable goal name
        targetDirection:
          oneOf:
          - $ref: '#/components/schemas/TargetDirection'
          - type: 'null'
        targetValue:
          type: [number, 'null']
        workflowChainIds:
          type: [array, 'null']
          items:
            type: string
            format: uuid
    GoalAnalyticsQueryInput:
      type: object
      required: [metric]
      properties:
        includePast:
          type: [boolean, 'null']
          description: Whether to include historical data points
        metric:
          type: string
          description: Analytics metric to evaluate
        windowDays:
          type: [integer, 'null']
          description: Rolling window size in days
    GoalAnalyticsQueryOutput:
      type: object
      required: [metric, windowDays]
      properties:
        includePast:
          type: boolean
          description: Whether to include historical data points
        metric:
          type: string
          description: Analytics metric to evaluate
        windowDays:
          type: integer
          description: Rolling window size in days
    GoalResponse:
      type: object
      required: [analyticsQuery, createdAt, name, uuid]
      properties:
        analyticsQuery:
          $ref: '#/components/schemas/GoalAnalyticsQueryOutput'
        createdAt:
          type: string
          format: date-time
        description:
          type: string
        metadata:
          type: object
          additionalProperties: true
        name:
          type: string
        targetDirection:
          $ref: '#/components/schemas/TargetDirection'
        targetValue:
          type: number
        uuid:
          type: string
          format: uuid
    HttpError:
      type: object
      required: [message]
      properties:
        hints:
          type: array
          items:
            type: string
        message:
          type: string
          example: error message
        slug:
          type: string
          example: error-slug
    ListGoalsOutput:
      type: object
      required: [goals, pageSize, total]
      properties:
        goals:
          type: [array, 'null']
          items:
            $ref: '#/components/schemas/GoalResponse'
        nextCursor:
          type: string
          format: uuid
        pageSize:
          type: integer
        total:
          type: integer
    TargetDirection:
      type: string
      enum: [gte, lte]
    UpdateGoalInput:
      type: object
      properties:
        analyticsQuery:
          oneOf:
          - $ref: '#/components/schemas/GoalAnalyticsQueryInput'
          - type: 'null'
        description:
          type: [string, 'null']
          description: Updated explanation
        name:
          type: [string, 'null']
          description: Updated goal name
        targetDirection:
          oneOf:
          - $ref: '#/components/schemas/TargetDirection'
          - type: 'null'
        targetValue:
          type: [number, 'null']
        workflowChainIds:
          type: [array, 'null']
          items:
            type: string
            format: uuid
