	transport := &contractTransport{responses: []*http.Response{contractResponse(200, map[string]string{"content-type": "application/json"}, "{\"id\":\"gnr8\",\"note\":\"gnr8\"}")}}
	client := contractClient(transport, WithAPIKeyHeader("ApiKeyAuth", "gnr8-contract-key"))
	out, err := client.ListItems(context.Background(), ListItemsParams{Limit: 7})
	if err != nil {
		t.Fatalf("ListItems: %v", err)
	}
	_ = out
	request := contractSingleRequest(t, transport)
	assertContractWire(t, request, "GET", "/items", url.Values{"limit": {"7"}}, map[string]string{"x-api-key": "gnr8-contract-key"})
